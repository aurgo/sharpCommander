<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);CS8602;CS8604;xUnit1031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.20" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.20" />
  </ItemGroup>
  <!--
    Test classes run one after another. When several start at once, Avalonia's headless platform now and then sets
    up the first windows without their fonts ("fonts:SystemFonts" was not present in the dictionary) and the whole
    run hangs; running them in turn costs about ten seconds and removes it.
  -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCommander.Core\SharpCommander.Core.csproj" />
    <ProjectReference Include="..\..\src\SharpCommander.Desktop\SharpCommander.Desktop.csproj" />
  </ItemGroup>
</Project>
