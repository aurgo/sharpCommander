<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SharpCommander.Desktop.Views.InputDialog"
        Title="Input" Width="350" Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Border Padding="20">
        <StackPanel Spacing="10">
            <TextBlock Name="PromptText" Text="Enter new name:" />
            <TextBox Name="InputBox" Text="" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="15,5" />
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="15,5" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
