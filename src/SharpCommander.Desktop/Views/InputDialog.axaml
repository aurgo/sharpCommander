<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SharpCommander.Desktop.Views.InputDialog"
        Title="Input"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Border Padding="20">
        <StackPanel Spacing="8">
            <TextBlock Name="PromptText" Classes="dialog-message" Text="Enter a value:" />
            <TextBox Name="InputBox" />
            <TextBlock Name="ErrorText" Classes="dialog-error" IsVisible="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Name="OkButton" Classes="dialog-button" Content="OK" IsDefault="True" Click="Ok_Click" />
                <Button Name="CancelButton" Classes="dialog-button" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
