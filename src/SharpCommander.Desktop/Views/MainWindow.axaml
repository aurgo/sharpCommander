<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SharpCommander.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SharpCommander.Desktop.ViewModels"
        xmlns:views="using:SharpCommander.Desktop.Views"
        xmlns:models="using:SharpCommander.Core.Models"
        xmlns:util="using:SharpCommander.Desktop.Utilities"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SharpCommander.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        x:Name="MainCommanderWindow"
        Icon="avares://SharpCommander.Desktop/Resources/icon.png">

    <!--
      Keyboard shortcuts are dispatched from MainWindow.OnKeyDown (see the Shortcuts table in the code-behind)
      rather than from Window.KeyBindings: Avalonia evaluates KeyBindings before the focused control sees the
      key, so a Delete or Ctrl+A binding here would act on files while the user edits the path box.
    -->

    <DockPanel>
        <!-- Menu bar, with the reminder of a newer release at its right end -->
        <DockPanel DockPanel.Dock="Top">
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Classes="update-pill"
                    IsVisible="{Binding AvailableUpdate, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Command="{Binding OpenUpdatePageCommand}" ToolTip.Tip="{loc:T Update_PillTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="M5 20h14v-2H5v2Zm14-9h-4V3H9v8H5l7 7 7-7Z" Width="13" Height="13" />
                    <TextBlock VerticalAlignment="Center"><Run Text="{loc:T Update_Pill}" /><Run Text=" " /><Run Text="{Binding AvailableVersion}" /></TextBlock>
                </StackPanel>
            </Button>
            <Menu>
                <MenuItem Header="{loc:T MainWindow_File}">
                    <MenuItem Header="{loc:T MainWindow_View}" InputGesture="F3" Command="{Binding ViewCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5M12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5m0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_Edit}" InputGesture="F4" Command="{Binding EditCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.37-.39-1.02-.39-1.41 0l-1.84 1.83 3.75 3.75M3 17.25V21h3.75L17.81 9.93l-3.75-3.75L3 17.25Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_Rename}" InputGesture="F2" Command="{Binding RenameCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M14.06 9.02l.92.92L5.92 19H5v-.92l9.06-9.06M17.66 3c-.25 0-.51.1-.7.29l-1.83 1.83 3.75 3.75 1.83-1.83a.996.996 0 0 0 0-1.41l-2.34-2.34c-.2-.2-.45-.29-.71-.29zm-3.6 3.19L3 17.25V21h3.75L17.81 9.94l-3.75-3.75z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_Copy}" InputGesture="F5" Command="{Binding CopyCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12V1Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_Move}" InputGesture="F6" Command="{Binding MoveCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6m4 18H6V4h7v5h5v11m-3-9v4h-4v-4H9l5-5 5 5h-3Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_NewFolder}" InputGesture="F7" Command="{Binding NewFolderCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M10 4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6m2 6v3h3v2h-3v3h-2v-3H7v-2h3v-3h2Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_Delete}" InputGesture="F8" Command="{Binding DeleteCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M19 4h-3.5l-1-1h-5l-1 1H5v2h14M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_DeletePermanently}" InputGesture="Shift+Delete" Command="{Binding DeletePermanentCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_EXit}" InputGesture="F10" Command="{Binding ExitCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M16 17v-3H9v-4h7V7l5 5-5 5M14 2a2 2 0 0 1 2 2v2h-2V4H5v16h9v-2h2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{loc:T MainWindow_Edit}">
                    <MenuItem Header="{Binding UndoDescription}" InputGesture="{x:Static util:Shortcuts.Undo}"
                              Command="{Binding UndoCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_SelectAll}" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M9 9H4v2h5V9m0 4H4v2h5v-2m6-8H4v2h11V5m2 12h2v2h-2v-2m0-8h2v2h-2V9m0 4h2v2h-2v-2m0-8h2v2h-2V5m-8 14H4v2h5v-2m4 0v2h2v-2h-2m4 0v2h2v-2h-2m0-12v2h2V7h-2m-4 0v2h2V7h-2Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_SelectByPattern}" InputGesture="{x:Static util:Shortcuts.SelectByPattern}"
                              Command="{Binding ActivePanel.SelectByPatternCommand}" />
                    <MenuItem Header="{loc:T MainWindow_UnselectByPattern}" InputGesture="{x:Static util:Shortcuts.UnselectByPattern}"
                              Command="{Binding ActivePanel.UnselectByPatternCommand}" />
                    <MenuItem Header="{loc:T MainWindow_InvertSelection}" InputGesture="{x:Static util:Shortcuts.InvertSelection}"
                              Command="{Binding ActivePanel.InvertSelectionCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_CalculateFolderSiZe}" InputGesture="{x:Static util:Shortcuts.FolderSize}"
                              Command="{Binding ActivePanel.CalculateFolderSizeCommand}" />
                    <MenuItem Header="{loc:T MainWindow_ChangeAttributes}" Command="{Binding ActivePanel.ChangeAttributesCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_CopYPath}" InputGesture="{x:Static util:Shortcuts.CopyPath}"
                              Command="{Binding ActivePanel.CopyPathCommand}" />
                    <MenuItem Header="{loc:T MainWindow_OpenTerminalHere}" InputGesture="{x:Static util:Shortcuts.OpenTerminal}"
                              Command="{Binding ActivePanel.OpenTerminalCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_Copy}" InputGesture="Ctrl+C" Command="{Binding CopyToClipboardCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12V1Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_CuT}" InputGesture="Ctrl+X" Command="{Binding CutToClipboardCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M19 3L13 9l1.4 1.4 5.6-5.6V3M12 10.6L7 5.6 5.6 7l5 5-5 5L7 18.4l5-5 5 5L18.4 17l-5-5 1.4-1.4L12 10.6M19 21v-2.4L13.4 13 12 14.4 17.6 20H19Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_Paste}" InputGesture="Ctrl+V" Command="{Binding PasteFromClipboardCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M19 20H5V4h7v7h7m-5.5-8v6.5H19L13.5 3M12 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_Refresh}" InputGesture="Ctrl+R" Command="{Binding RefreshCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 0 0-8 8 8 8 0 0 0 8 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18a6 6 0 0 1-6-6 6 6 0 0 1 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_Filter}" InputGesture="Ctrl+F" Command="{Binding ToggleSearchCommand}" />
                    <MenuItem Header="{loc:T MainWindow_ShowHiddenFiles}" InputGesture="Ctrl+H" Command="{Binding ActivePanel.ToggleShowHiddenFilesCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_SyncPanels}" Command="{Binding SyncPanelsCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M18 12l4-4-4-4v3H3v2h15v3M6 12l-4 4 4 4v-3h15v-2H6v-3Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_SWapPanels}" InputGesture="F9" Command="{Binding SwapPanelsCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M21 9l-4-4v3H3v2h14v3l4-4M3 15l4 4v-3h14v-2H7v-3l-4 4Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{loc:T MainWindow_View}">
                    <MenuItem Header="{loc:T MainWindow_NewTab}" InputGesture="Ctrl+T" Command="{Binding NewTabCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2m0 16H5V5h14v14m-8-2h2v-4h4v-2h-4V7h-2v4H7v2h4v4Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_DuplicateTab}" InputGesture="{x:Static util:Shortcuts.DuplicateTab}"
                              Command="{Binding DuplicateTabCommand}" />
                    <MenuItem Header="{loc:T MainWindow_PinTab}" ToggleType="CheckBox" IsChecked="{Binding CurrentTab.IsPinned, Mode=OneWay}"
                              Command="{Binding TogglePinCommand}" />
                    <MenuItem Header="{loc:T MainWindow_CloseTab}" InputGesture="Ctrl+W" Command="{Binding CloseCurrentTabCommand}" />
                    <MenuItem Header="{loc:T MainWindow_NeXtTab}" InputGesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
                    <MenuItem Header="{loc:T MainWindow_PreviousTab}" InputGesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_FavoritesPanel}" InputGesture="Ctrl+B" ToggleType="CheckBox"
                              IsChecked="{Binding ShowFavoritesPanel, Mode=OneWay}"
                              Command="{Binding ToggleFavoritesPanelCommand}" />
                    <MenuItem Header="{loc:T MainWindow_ToggleFavoRite}" InputGesture="Ctrl+D" Command="{Binding ToggleFavoriteCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{x:Static util:EntryIcons.StarFilled}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_Language}" ItemsSource="{Binding Languages}">
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                          x:DataType="loc:LanguageOption">
                                <Setter Property="Header" Value="{Binding DisplayName}" />
                                <Setter Property="Command" Value="{Binding $parent[Menu].((vm:MainWindowViewModel)DataContext).SetLanguageCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding Code}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_Theme}">
                        <MenuItem Header="{loc:T MainWindow_SystemDefault}" ToggleType="Radio"
                                  IsChecked="{Binding CurrentTheme, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=System, Mode=OneWay}"
                                  Command="{Binding SetThemeCommand}" CommandParameter="System" />
                        <MenuItem Header="{loc:T MainWindow_Light}" ToggleType="Radio"
                                  IsChecked="{Binding CurrentTheme, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Light, Mode=OneWay}"
                                  Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                        <MenuItem Header="{loc:T MainWindow_Dark}" ToggleType="Radio"
                                  IsChecked="{Binding CurrentTheme, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Dark, Mode=OneWay}"
                                  Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{loc:T MainWindow_Tools}">
                    <MenuItem Header="{loc:T MainWindow_ConnectSftp}" Command="{Binding ConnectSftpCommand}" />
                    <MenuItem Header="{loc:T MainWindow_DisconnectSftp}" Command="{Binding DisconnectSftpCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_Pack}" Command="{Binding PackCommand}" />
                    <MenuItem Header="{loc:T MainWindow_Extract}" Command="{Binding ExtractCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_CompareFiles}" Command="{Binding CompareFilesCommand}" />
                    <MenuItem Header="{loc:T MainWindow_CompareFolders}" Command="{Binding CompareDirectoriesCommand}" />
                    <MenuItem Header="{loc:T MainWindow_SYnchronizeFolders}" Command="{Binding SynchronizeDirectoriesCommand}" />
                    <MenuItem Header="{loc:T MainWindow_MirrorFolders}" Command="{Binding MirrorDirectoriesCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_AdvancedSearch}" InputGesture="Ctrl+Shift+F" Command="{Binding ShowAdvancedSearchCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.516 6.516 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_MassRename}" InputGesture="Ctrl+M" Command="{Binding ShowMassRenameCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.37-.39-1.02-.39-1.41 0l-1.84 1.83 3.75 3.75M3 17.25V21h3.75L17.81 9.93l-3.75-3.75L3 17.25Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:T MainWindow_CalculateHash}" InputGesture="Ctrl+Shift+H" Command="{Binding CalculateHashCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2m0 2v14h14V5H5m2 2h10v2H7V7m0 4h10v2H7v-2m0 4h7v2H7v-2Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_SpaceAnalyzer}" Command="{Binding OpenSpaceAnalyzerCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{x:Static util:EntryIcons.Treemap}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{loc:T MainWindow_Help}">
                    <MenuItem Header="{loc:T MainWindow_CheckUpdates}" Command="{Binding CheckForUpdatesNowCommand}" />
                    <MenuItem Header="{loc:T MainWindow_AutoCheckUpdates}" ToggleType="CheckBox"
                              IsChecked="{Binding CheckForUpdates, Mode=OneWay}"
                              Command="{Binding ToggleUpdateChecksCommand}" />
                    <Separator />
                    <MenuItem Header="{loc:T MainWindow_AboutSharpcommander}" Click="About_Click">
                        <MenuItem.Icon>
                            <PathIcon Data="M11 9h2V7h-2m1 13c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8m0-18A10 10 0 0 0 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2m-1 15h2v-6h-2v6Z" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </DockPanel>

        <!--
          Ribbon: the everyday commands in named groups, each a large icon over its label, as in Office and
          Explorer. The menus above keep the complete list; this is what is used all the time.
        -->
        <Border DockPanel.Dock="Top" Classes="ribbon">
            <StackPanel x:Name="Ribbon" Orientation="Horizontal">
                <Grid Classes="ribbon-group" RowDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="ribbon-button" Command="{Binding ViewCommand}" ToolTip.Tip="{loc:T MainWindow_ViewF3}">
                            <StackPanel>
                                <PathIcon Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5M12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5m0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3Z" />
                                <TextBlock Text="{loc:T MainWindow_View2}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ribbon-button" Command="{Binding EditCommand}" ToolTip.Tip="{loc:T MainWindow_EditF4}">
                            <StackPanel>
                                <PathIcon Data="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.37-.39-1.02-.39-1.41 0l-1.84 1.83 3.75 3.75M3 17.25V21h3.75L17.81 9.93l-3.75-3.75L3 17.25Z" />
                                <TextBlock Text="{loc:T MainWindow_Edit2}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Classes="ribbon-caption" Text="{loc:T Ribbon_Open}" />
                </Grid>

                <Rectangle Classes="ribbon-separator" />

                <Grid Classes="ribbon-group" RowDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="ribbon-button" Command="{Binding CopyCommand}" ToolTip.Tip="{loc:T MainWindow_CopyToTheOtherPanelF5}">
                            <StackPanel>
                                <PathIcon Data="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12V1Z" />
                                <TextBlock Text="{loc:T MainWindow_Copy2}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ribbon-button" Command="{Binding MoveCommand}" ToolTip.Tip="{loc:T MainWindow_MoveToTheOtherPanelF6}">
                            <StackPanel>
                                <PathIcon Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6m4 18H6V4h7v5h5v11m-3-9v4h-4v-4H9l5-5 5 5h-3Z" />
                                <TextBlock Text="{loc:T MainWindow_Move2}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ribbon-button" Command="{Binding NewFolderCommand}" ToolTip.Tip="{loc:T MainWindow_NewFolderF7}">
                            <StackPanel>
                                <Image Source="{x:Static util:EntryImages.NewFolder}" />
                                <TextBlock Text="{loc:T MainWindow_NewFolder2}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ribbon-button" Command="{Binding DeleteCommand}" ToolTip.Tip="{loc:T MainWindow_DeleteF8ShiftDeleteDeletesPermanently}">
                            <StackPanel>
                                <PathIcon Data="M19 4h-3.5l-1-1h-5l-1 1H5v2h14M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12Z"
                                          Foreground="{DynamicResource RibbonDangerBrush}" />
                                <TextBlock Text="{loc:T MainWindow_Delete2}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Classes="ribbon-caption" Text="{loc:T Ribbon_Organize}" />
                </Grid>

                <Rectangle Classes="ribbon-separator" />

                <Grid Classes="ribbon-group" RowDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="ribbon-button" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:T MainWindow_RefreshBothPanelsCtrlR}">
                            <StackPanel>
                                <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 0 0-8 8 8 8 0 0 0 8 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18a6 6 0 0 1-6-6 6 6 0 0 1 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z" />
                                <TextBlock Text="{loc:T MainWindow_Refresh2}" />
                            </StackPanel>
                        </Button>
                        <!-- Shown pressed while the favorites panel is open. -->
                        <Button Classes="ribbon-button" Classes.checked="{Binding ShowFavoritesPanel}"
                                Command="{Binding ToggleFavoritesPanelCommand}" ToolTip.Tip="{loc:T MainWindow_ToggleTheFavoritesPanelCtrlB}">
                            <StackPanel>
                                <PathIcon Data="{x:Static util:EntryIcons.StarFilled}" Foreground="{x:Static util:PanelBrushes.FavoriteOn}" />
                                <TextBlock Text="{loc:T MainWindow_Favorites}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Classes="ribbon-caption" Text="{loc:T Ribbon_Panels}" />
                </Grid>

                <Rectangle Classes="ribbon-separator" />

                <Grid Classes="ribbon-group" RowDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="ribbon-button" Command="{Binding ConnectSftpCommand}" ToolTip.Tip="{loc:T MainWindow_ConnectSftpTip}">
                            <StackPanel>
                                <PathIcon Data="M4 1h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2m0 2v4h16V3H4m2 1h2v2H6V4m4 0h2v2h-2V4M4 11h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2m0 2v4h16v-4H4m2 1h2v2H6v-2m4 0h2v2h-2v-2M4 21h16v2H4v-2Z" />
                                <TextBlock Text="{loc:T MainWindow_Server}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SpaceAnalyzerButton" Classes="ribbon-button" Command="{Binding OpenSpaceAnalyzerCommand}" ToolTip.Tip="{loc:T MainWindow_SpaceAnalyzerTip}">
                            <StackPanel>
                                <PathIcon Data="{x:Static util:EntryIcons.Treemap}" Foreground="{DynamicResource RibbonSpaceAnalyzerBrush}" />
                                <TextBlock Text="{loc:T MainWindow_SpaceAnalyzer2}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Classes="ribbon-caption" Text="{loc:T Ribbon_Tools}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tab bar: tabs opened from the left pane sit on the left, those from the right pane on the right -->
        <Border DockPanel.Dock="Top" Classes="tab-bar">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="tab-add"
                        Command="{Binding NewTabCommand}" CommandParameter="Right"
                        ToolTip.Tip="{loc:T MainWindow_NewTabRight}">
                    <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="14" Height="14" />
                </Button>

                <ItemsControl x:Name="RightTabStrip" DockPanel.Dock="Right" ItemsSource="{Binding RightTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TabViewModel">
                            <Border Classes="tab" Classes.current="{Binding IsCurrent}" Classes.pinned="{Binding IsPinned}" PointerPressed="Tab_PointerPressed">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T MainWindow_DuplicateTab2}"
                                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DuplicateTabCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{loc:T MainWindow_PinTab2}" ToggleType="CheckBox" IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePinCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="{loc:T MainWindow_CloseTab2}"
                                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    <Button Classes="tab-close"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RightTabs.Count, Converter={x:Static util:PanelConverters.MoreThanOne}}"
                                            ToolTip.Tip="{loc:T MainWindow_CloseTabCtrlW}">
                                        <PathIcon Data="{x:Static util:EntryIcons.Close}" Width="10" Height="10" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ItemsControl x:Name="LeftTabStrip" ItemsSource="{Binding LeftTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TabViewModel">
                            <Border Classes="tab" Classes.current="{Binding IsCurrent}" Classes.pinned="{Binding IsPinned}" PointerPressed="Tab_PointerPressed">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T MainWindow_DuplicateTab2}"
                                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DuplicateTabCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{loc:T MainWindow_PinTab2}" ToggleType="CheckBox" IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TogglePinCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="{loc:T MainWindow_CloseTab2}"
                                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    <Button Classes="tab-close"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LeftTabs.Count, Converter={x:Static util:PanelConverters.MoreThanOne}}"
                                            ToolTip.Tip="{loc:T MainWindow_CloseTabCtrlW}">
                                        <PathIcon Data="{x:Static util:EntryIcons.Close}" Width="10" Height="10" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="tab-add"
                        Command="{Binding NewTabCommand}" CommandParameter="Left"
                        ToolTip.Tip="{loc:T MainWindow_NewTabLeft}">
                    <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="14" Height="14" />
                </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Function Keys Bar (Bottom) -->
        <Border DockPanel.Dock="Bottom" Classes="function-bar" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*">
                <Button Grid.Column="0" Classes="function-button" Command="{Binding ViewCommand}">
                    <TextBlock><Run FontWeight="Bold">F3</Run><Run Text=" " /><Run Text="{loc:T FunctionBar_View}" /></TextBlock>
                </Button>
                <Button Grid.Column="1" Classes="function-button" Command="{Binding EditCommand}">
                    <TextBlock><Run FontWeight="Bold">F4</Run><Run Text=" " /><Run Text="{loc:T FunctionBar_Edit}" /></TextBlock>
                </Button>
                <Button Grid.Column="2" Classes="function-button" Command="{Binding CopyCommand}">
                    <TextBlock><Run FontWeight="Bold">F5</Run><Run Text=" " /><Run Text="{loc:T FunctionBar_Copy}" /></TextBlock>
                </Button>
                <Button Grid.Column="3" Classes="function-button" Command="{Binding MoveCommand}">
                    <TextBlock><Run FontWeight="Bold">F6</Run><Run Text=" " /><Run Text="{loc:T FunctionBar_Move}" /></TextBlock>
                </Button>
                <Button Grid.Column="4" Classes="function-button" Command="{Binding NewFolderCommand}">
                    <TextBlock><Run FontWeight="Bold">F7</Run><Run Text=" " /><Run Text="{loc:T FunctionBar_NewDir}" /></TextBlock>
                </Button>
                <Button Grid.Column="5" Classes="function-button" Command="{Binding DeleteCommand}">
                    <TextBlock><Run FontWeight="Bold">F8</Run><Run Text=" " /><Run Text="{loc:T FunctionBar_Delete}" /></TextBlock>
                </Button>
                <Button Grid.Column="6" Classes="function-button" Command="{Binding SwapPanelsCommand}">
                    <TextBlock><Run FontWeight="Bold">F9</Run><Run Text=" " /><Run Text="{loc:T FunctionBar_Swap}" /></TextBlock>
                </Button>
                <Button Grid.Column="7" Classes="function-button" Command="{Binding ExitCommand}">
                    <TextBlock><Run FontWeight="Bold">F10</Run><Run Text=" " /><Run Text="{loc:T FunctionBar_Exit}" /></TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- Status Bar: last message on the left, running operation on the right -->
        <Border DockPanel.Dock="Bottom" Classes="main-status-bar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusMessageText"
                           Grid.Column="0"
                           Classes="status-text"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="OperationPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding Operations.IsRunning}">
                    <TextBlock Classes="status-text" Text="{Binding Operations.OperationName}" />
                    <ProgressBar x:Name="OperationProgress"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding Operations.Percent}"
                                 Width="160"
                                 VerticalAlignment="Center" />
                    <TextBlock Classes="status-text" Text="{Binding Operations.ProcessedItems, StringFormat='{}{0} of'}" />
                    <TextBlock Classes="status-text" Text="{Binding Operations.TotalItems, StringFormat='{}{0} items'}" />
                    <TextBlock Classes="status-text"
                               Text="{Binding Operations.CurrentFile}"
                               MaxWidth="320"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CancelOperationButton"
                            Content="{loc:T MainWindow_Cancel}"
                            Padding="10,2"
                            Command="{Binding Operations.CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Favorites Panel (Left Side) -->
            <Border Grid.Column="0"
                    IsVisible="{Binding ShowFavoritesPanel}"
                    Width="180"
                    Classes="favorites-panel"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8">
                        <PathIcon Data="{x:Static util:EntryIcons.StarFilled}" Width="14" Height="14" Foreground="{x:Static util:PanelBrushes.FavoriteOn}" />
                        <TextBlock Text="{loc:T MainWindow_Favorites}" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="FavoritesListBox"
                             Classes="favorites-list"
                             ItemsSource="{Binding LeftPanel.Favorites}"
                             Background="Transparent"
                             Tapped="Favorites_Tapped"
                             KeyDown="Favorites_KeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu Closed="FavoritesMenu_Closed">
                                <MenuItem Header="{loc:T MainWindow_Open}"
                                          Command="{Binding ActivePanel.NavigateToFavoriteCommand}"
                                          CommandParameter="{Binding #FavoritesListBox.SelectedItem}" />
                                <MenuItem Header="{loc:T MainWindow_OpenInOtherPanel}"
                                          Command="{Binding OpenFavoriteInOtherPanelCommand}"
                                          CommandParameter="{Binding #FavoritesListBox.SelectedItem}" />
                                <Separator />
                                <MenuItem Header="{loc:T MainWindow_Rename2}"
                                          Command="{Binding RenameFavoriteCommand}"
                                          CommandParameter="{Binding #FavoritesListBox.SelectedItem}" />
                                <MenuItem Header="{loc:T MainWindow_Remove}"
                                          Command="{Binding RemoveFavoriteCommand}"
                                          CommandParameter="{Binding #FavoritesListBox.SelectedItem}" />
                                <Separator />
                                <MenuItem Header="{loc:T MainWindow_RestoreDefaultFavorites}" Command="{Binding RestoreDefaultFavoritesCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FavoriteItem">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2" ToolTip.Tip="{Binding Path}">
                                    <Image Width="18" Height="18"
                                           Source="{Binding IconKey, Converter={x:Static util:FavoriteImageConverter.Instance}}" />
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Dual Pane File Browser -->
            <Grid Grid.Column="1" ColumnDefinitions="*,4,*">
                <views:FilePanelView x:Name="LeftPanelView"
                                     Grid.Column="0"
                                     DataContext="{Binding LeftPanel}"
                                     GotFocus="LeftPanel_GotFocus" />

                <GridSplitter Grid.Column="1"
                              Width="4"
                              Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                              ResizeBehavior="PreviousAndNext" />

                <views:FilePanelView x:Name="RightPanelView"
                                     Grid.Column="2"
                                     DataContext="{Binding RightPanel}"
                                     GotFocus="RightPanel_GotFocus" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
