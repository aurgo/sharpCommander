<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SharpCommander.Desktop.Localization"
        xmlns:vm="using:SharpCommander.Desktop.ViewModels"
        xmlns:models="using:SharpCommander.Core.Models"
        xmlns:util="using:SharpCommander.Desktop.Utilities"
        x:Class="SharpCommander.Desktop.Views.SearchWindow"
        x:DataType="vm:SearchViewModel"
        Title="{loc:T SearchWindow_AdvancedSearch}"
        Width="680" Height="560"
        MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <Border Padding="16">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T SearchWindow_SearchIn}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SearchPath}" IsEnabled="{Binding !IsSearching}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T SearchWindow_FileName}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Name="PatternBox" Text="{Binding FileNamePattern}" IsEnabled="{Binding !IsSearching}" Watermark="{loc:T SearchWindow_PatternWithAndForExampleTxt}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T SearchWindow_Containing}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ContentPattern}" IsEnabled="{Binding !IsSearching}" Watermark="{loc:T SearchWindow_TextThatTheFileMustContain}" />

                <CheckBox Grid.Row="3" Grid.Column="1" Content="{loc:T SearchWindow_FileNameIsARegularExpression}" IsChecked="{Binding UseRegex}" IsEnabled="{Binding !IsSearching}" />
            </Grid>

            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="dialog-secondary" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="dialog-button" Content="{loc:T SearchWindow_Start}" Command="{Binding StartSearchCommand}" IsDefault="True" IsVisible="{Binding !IsSearching}" />
                    <Button Classes="dialog-button" Content="{loc:T SearchWindow_Cancel}" Command="{Binding CancelSearchCommand}" IsVisible="{Binding IsSearching}" />
                    <Button Classes="dialog-button" Content="{loc:T SearchWindow_GoTo}" Command="{Binding ActivateResultCommand}" ToolTip.Tip="{loc:T SearchWindow_ShowTheSelectedResultInThe}" />
                    <Button Classes="dialog-button" Content="{loc:T SearchWindow_Close}" Click="Close_Click" IsCancel="True" />
                </StackPanel>
            </Grid>

            <ListBox Name="ResultsList"
                     Margin="0,12,0,0"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                     CornerRadius="4"
                     DoubleTapped="ResultsList_DoubleTapped"
                     KeyDown="ResultsList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FileSystemEntry">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <PathIcon Grid.Column="0" Width="16" Height="16" Data="{Binding EntryType, Converter={x:Static util:EntryIconConverter.Instance}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FullPath}" Classes="dialog-secondary" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
