<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SharpCommander.Core.Models"
        x:Class="SharpCommander.Desktop.Views.OperationErrorsDialog"
        Title="Errors"
        Width="640" Height="420"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Padding="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Name="SummaryText" Classes="dialog-title" Margin="0,0,0,12" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                <Button Name="CopyAllButton" Classes="dialog-button" Content="Copy all" Click="CopyAll_Click" />
                <Button Name="CloseButton" Classes="dialog-button" Content="Close" IsDefault="True" IsCancel="True" Click="Close_Click" />
            </StackPanel>

            <ListBox Name="ErrorsList" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" CornerRadius="4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FileOperationError">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Path}" ToolTip.Tip="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Message}" Classes="dialog-secondary" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
