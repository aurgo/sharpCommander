<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpCommander.Desktop.ViewModels"
        x:Class="SharpCommander.Desktop.Views.MassRenameWindow"
        x:DataType="vm:MassRenameViewModel"
        Title="Mass Rename Tool"
        Width="850" Height="650"
        WindowStartupLocation="CenterOwner">

    <Border Padding="15">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" Margin="0,0,0,15">
                <!-- Mask Settings -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,15">
                    <TextBlock Text="File Name Mask:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding FileNameMask}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="5,0,0,0">
                            <Button Content="[N]" Command="{Binding InsertMaskCommand}" CommandParameter="[N]" ToolTip.Tip="Insert Name" Padding="5,0" />
                            <Button Content="[C]" Command="{Binding InsertMaskCommand}" CommandParameter="[C]" ToolTip.Tip="Insert Counter" Padding="5,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0,0,15">
                    <TextBlock Text="Extension Mask:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding ExtensionMask}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="5,0,0,0">
                            <Button Content="[E]" Command="{Binding InsertMaskExtCommand}" CommandParameter="[E]" ToolTip.Tip="Insert Extension" Padding="5,0" />
                            <Button Content="[C]" Command="{Binding InsertMaskExtCommand}" CommandParameter="[C]" ToolTip.Tip="Insert Counter" Padding="5,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Search & Replace -->
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,15">
                    <TextBlock Text="Search for:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SearchPattern}" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="10,0,0,15">
                    <TextBlock Text="Replace with:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ReplacePattern}" />
                </StackPanel>

                <!-- Options -->
                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,10,15">
                    <TextBlock Text="Options:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <CheckBox Content="Use Regular Expressions (Regex)" IsChecked="{Binding UseRegex}" Margin="0,0,0,5" />
                    
                    <TextBlock Text="Case Conversion:" Margin="0,5,0,5" />
                    <ComboBox SelectedIndex="{Binding CaseOption}" HorizontalAlignment="Stretch">
                        <ComboBoxItem>No change</ComboBoxItem>
                        <ComboBoxItem>lowercase</ComboBoxItem>
                        <ComboBoxItem>UPPERCASE</ComboBoxItem>
                        <ComboBoxItem>Title Case</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Counter Options -->
                <StackPanel Grid.Column="1" Grid.Row="2" Margin="10,0,0,15">
                    <TextBlock Text="Counter [C] Settings:" FontWeight="Bold" Margin="0,0,0,5"/>
                    
                    <Grid ColumnDefinitions="Auto, *, Auto, *" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Start:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding CounterStart}" Minimum="0" FormatString="0" Margin="0,0,10,10" />
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Step:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding CounterStep}" Minimum="1" FormatString="0" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Digits:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding CounterPadding}" Minimum="1" Maximum="10" FormatString="0" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Actions & Status -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto, *, Auto" Margin="0,15,0,0" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontStyle="Italic" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="Apply Rename" Command="{Binding ApplyCommand}" Background="Firebrick" Foreground="White" Padding="20,10" FontWeight="Bold" CornerRadius="4" />
                </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" CornerRadius="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Old Name" Binding="{Binding OldName}" Width="*" />
                    <DataGridTextColumn Header="New Name" Binding="{Binding NewName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</Window>
