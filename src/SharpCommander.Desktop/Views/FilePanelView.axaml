<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:SharpCommander.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SharpCommander.Desktop.ViewModels"
             xmlns:models="using:SharpCommander.Core.Models"
             xmlns:util="using:SharpCommander.Desktop.Utilities"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="SharpCommander.Desktop.Views.FilePanelView"
             x:DataType="vm:FilePanelViewModel"
             DragDrop.AllowDrop="True"
             Focusable="True">

    <Border Classes="file-panel">
        <DockPanel>
            <!-- Panel header: navigation buttons, path box and actions -->
            <Border x:Name="PanelHeader" DockPanel.Dock="Top" Classes="panel-header">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                        <Button Command="{Binding NavigateUpCommand}"
                                IsEnabled="{Binding !IsRootView}"
                                Padding="6,4"
                                ToolTip.Tip="{loc:T FilePanelView_GoUpBackspace}">
                            <PathIcon Data="{x:Static util:EntryIcons.Parent}" Width="14" Height="14" />
                        </Button>
                        <Button Command="{Binding NavigateToRootCommand}"
                                Padding="6,4"
                                ToolTip.Tip="{loc:T FilePanelView_ComputerDrives}">
                            <PathIcon Data="M4 6h16v10H4V6m16-2H4c-1.11 0-2 .89-2 2v10c0 1.11.89 2 2 2h6v2H8v2h8v-2h-2v-2h6c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2Z"
                                      Width="14" Height="14" />
                        </Button>
                    </StackPanel>

                    <AutoCompleteBox x:Name="PathBox"
                                     Grid.Column="1"
                                     Classes="path-combo"
                                     Text="{Binding EditablePath}"
                                     ItemsSource="{Binding NavigationHistory}"
                                     ValueMemberBinding="{Binding Path, x:DataType=models:NavigationHistoryItem}"
                                     FilterMode="Contains"
                                     Margin="4,0"
                                     HorizontalAlignment="Stretch"
                                     Watermark="{loc:T FilePanelView_EnterAPathAndPressEnter}">
                        <!--
                            ValueMemberBinding is what the drop-down filters, completes and commits on. Without it
                            AutoCompleteBox falls back to item.ToString(), i.e. the type name, so no real path ever
                            matched. Enter is handled in the code-behind rather than through a KeyBinding: key
                            bindings run before the control sees the key, which stopped the drop-down from ever
                            committing a highlighted suggestion.
                        -->
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationHistoryItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{x:Static util:EntryIcons.Folder}"
                                              Width="14" Height="14"
                                              Foreground="{DynamicResource SystemAccentColor}" />
                                    <TextBlock Text="{Binding Path}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Command="{Binding NavigateToPathCommand}"
                                Padding="6,4"
                                ToolTip.Tip="{loc:T FilePanelView_GoToTheTypedPathEnter}">
                            <PathIcon Data="M4 11v2h12l-5.5 5.5 1.42 1.42L19.84 12l-7.92-7.92L10.5 5.5 16 11H4Z"
                                      Width="14" Height="14" />
                        </Button>
                        <Button Command="{Binding OpenInFileExplorerCommand}"
                                IsEnabled="{Binding !IsRootView}"
                                Padding="6,4"
                                ToolTip.Tip="{loc:T FilePanelView_ShowInTheSystemFileManager}">
                            <PathIcon Data="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                                      Width="14" Height="14" />
                        </Button>
                        <Button x:Name="FavoriteButton"
                                Command="{Binding ToggleFavoriteCommand}"
                                IsEnabled="{Binding !IsRootView}"
                                Padding="6,4"
                                ToolTip.Tip="{loc:T FilePanelView_ToggleFavoriteCtrlD}">
                            <PathIcon Width="14" Height="14"
                                      Data="{Binding IsFavorite, Converter={x:Static util:PanelConverters.FavoriteIcon}}"
                                      Foreground="{Binding IsFavorite, Converter={x:Static util:PanelConverters.FavoriteBrush}}" />
                        </Button>
                        <Button Command="{Binding ToggleSearchCommand}"
                                Padding="6,4"
                                ToolTip.Tip="{loc:T FilePanelView_FilterCtrlF}">
                            <PathIcon Data="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.516 6.516 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5Z"
                                      Width="14" Height="14" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}"
                                Padding="6,4"
                                ToolTip.Tip="{loc:T FilePanelView_RefreshCtrlR}">
                            <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 0 0-8 8 8 8 0 0 0 8 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18a6 6 0 0 1-6-6 6 6 0 0 1 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z"
                                      Width="14" Height="14" />
                        </Button>
                    </StackPanel>

                    <!-- Filter box, shown by Ctrl+F -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3"
                            IsVisible="{Binding IsSearchActive}"
                            Margin="0,4,0,0"
                            Padding="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="0"
                                     Text="{Binding SearchFilter}"
                                     Watermark="{loc:T FilePanelView_TypeToFilterTheListEsc}"
                                     KeyDown="SearchBox_KeyDown"
                                     Classes="search-input" />
                            <Button Grid.Column="1"
                                    Command="{Binding ClearSearchCommand}"
                                    Padding="6,4"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="{loc:T FilePanelView_ClearTheFilterEsc}">
                                <PathIcon Data="{x:Static util:EntryIcons.Close}" Width="12" Height="12" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Status line -->
            <Border DockPanel.Dock="Bottom" Classes="status-bar">
                <TextBlock x:Name="StatusTextBlock" Classes="status-text" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </Border>

            <ProgressBar DockPanel.Dock="Top"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Height="2" />

            <!-- Column headers: click to sort, click again to flip the direction -->
            <Grid DockPanel.Dock="Top" Classes="column-headers" ColumnDefinitions="*,120,160" Margin="36,0,12,0">
                <Button x:Name="NameHeader" Grid.Column="0" Classes="column-header"
                        Command="{Binding SortByCommand}" CommandParameter="Name"
                        HorizontalContentAlignment="Left"
                        ToolTip.Tip="{loc:T FilePanelView_SortByName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:T FilePanelView_Name}" />
                        <TextBlock Text="{Binding NameSortIndicator}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SizeHeader" Grid.Column="1" Classes="column-header"
                        Command="{Binding SortByCommand}" CommandParameter="Size"
                        HorizontalContentAlignment="Right"
                        ToolTip.Tip="{loc:T FilePanelView_SortBySize}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:T FilePanelView_Size}" />
                        <TextBlock Text="{Binding SizeSortIndicator}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ModifiedHeader" Grid.Column="2" Classes="column-header"
                        Command="{Binding SortByCommand}" CommandParameter="Modified"
                        HorizontalContentAlignment="Right"
                        ToolTip.Tip="{loc:T FilePanelView_SortByModificationDate}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:T FilePanelView_Modified}" />
                        <TextBlock Text="{Binding ModifiedSortIndicator}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- File list -->
            <ListBox x:Name="FileListBox"
                     Classes="file-list"
                     ItemsSource="{Binding FilteredEntries}"
                     SelectionMode="Multiple"
                     DoubleTapped="ListBox_DoubleTapped"
                     KeyDown="ListBox_KeyDown"
                     PointerMoved="ListBox_PointerMoved"
                     SelectionChanged="ListBox_SelectionChanged">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:T FilePanelView_Open}" InputGesture="Enter" Command="{Binding OpenSelectedCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_OpenInNewTab}" Click="OnOpenInNewTabClick">
                            <MenuItem.Icon>
                                <PathIcon Data="M21 3H3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10v-2H3V7h18v6h2V5a2 2 0 0 0-2-2m-3 12v3h-3v2h3v3h2v-3h3v-2h-3v-3h-2Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_ShowInFileManager}" Command="{Binding RevealInFileExplorerCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{x:Static util:EntryIcons.Folder}" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_ChangeAttributes}" Command="{Binding ChangeAttributesCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_CalculateFolderSize}" Command="{Binding CalculateFolderSizeCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M3 3h8v8H3V3m10 0h8v8h-8V3M3 13h8v8H3v-8m10 4h3v-3h2v3h3v2h-3v3h-2v-3h-3v-2Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_OpenTerminalHere}" Command="{Binding OpenTerminalCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m0 14H4V8h16v10M6.5 10.5 9 13l-2.5 2.5 1 1L12 13l-4.5-3.5-1 1M13 15h5v1.5h-5V15Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:T FilePanelView_CopyPath}" Command="{Binding CopyPathCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12V1Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_Cut}" InputGesture="Ctrl+X" Command="{Binding CutCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M19 3L13 9l1.4 1.4 5.6-5.6V3M12 10.6L7 5.6 5.6 7l5 5-5 5L7 18.4l5-5 5 5L18.4 17l-5-5 1.4-1.4L12 10.6M19 21v-2.4L13.4 13 12 14.4 17.6 20H19Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_Copy}" InputGesture="Ctrl+C" Command="{Binding CopyCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12V1Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_Paste}" InputGesture="Ctrl+V" Command="{Binding PasteCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M19 2h-4.18C14.4.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2m-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1m7 18H5V4h2v3h10V4h2v16Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:T FilePanelView_Rename}" InputGesture="F2" Command="{Binding RenameSelectedCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.37-.39-1.02-.39-1.41 0l-1.84 1.83 3.75 3.75M3 17.25V21h3.75L17.81 9.93l-3.75-3.75L3 17.25Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_DeleteF8}" Command="{Binding DeleteSelectedCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="16" Height="16" Foreground="{StaticResource DangerBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_DeletePermanently}" InputGesture="Shift+Delete" Command="{Binding DeleteSelectedPermanentlyCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:T FilePanelView_AddToFavorites}" Command="{Binding AddToFavoritesCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{x:Static util:EntryIcons.StarFilled}" Width="16" Height="16" Foreground="{x:Static util:PanelBrushes.FavoriteOn}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:T FilePanelView_SortBy}">
                            <MenuItem Header="{loc:T FilePanelView_Name}" ToggleType="Radio" IsChecked="{Binding IsSortedByName, Mode=OneWay}"
                                      Command="{Binding SortByCommand}" CommandParameter="Name" />
                            <MenuItem Header="{loc:T FilePanelView_Size}" ToggleType="Radio" IsChecked="{Binding IsSortedBySize, Mode=OneWay}"
                                      Command="{Binding SortByCommand}" CommandParameter="Size" />
                            <MenuItem Header="{loc:T FilePanelView_Modified}" ToggleType="Radio" IsChecked="{Binding IsSortedByModified, Mode=OneWay}"
                                      Command="{Binding SortByCommand}" CommandParameter="Modified" />
                            <Separator />
                            <MenuItem Header="{loc:T FilePanelView_Descending}" ToggleType="CheckBox" IsChecked="{Binding SortDescending, Mode=OneWay}"
                                      Command="{Binding ToggleSortDirectionCommand}" />
                        </MenuItem>
                        <MenuItem Header="{loc:T FilePanelView_ShowHiddenFiles}" InputGesture="Ctrl+H" ToggleType="CheckBox"
                                  IsChecked="{Binding ShowHiddenFiles, Mode=OneWay}"
                                  Command="{Binding ToggleShowHiddenFilesCommand}" />
                        <MenuItem Header="{loc:T FilePanelView_Refresh}" InputGesture="Ctrl+R" Command="{Binding RefreshCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 0 0-8 8 8 8 0 0 0 8 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18a6 6 0 0 1-6-6 6 6 0 0 1 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:T FilePanelView_Properties}" Command="{Binding ShowPropertiesCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="M11 9h2V7h-2m1 13c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8m0-18A10 10 0 0 0 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2m-1 15h2v-6h-2v6Z" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:FileSystemEntry">
                        <Grid ColumnDefinitions="Auto,*,120,160" Margin="4,2"
                              Opacity="{Binding IsHidden, Converter={x:Static util:PanelConverters.HiddenOpacity}}">
                            <PathIcon Grid.Column="0"
                                      Width="16" Height="16" Margin="0,0,8,0"
                                      Data="{Binding EntryType, Converter={x:Static util:EntryIconConverter.Instance}}"
                                      Foreground="{Binding EntryType, Converter={x:Static util:PanelConverters.EntryBrush}}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Converter={x:Static util:PanelConverters.EntrySize}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Converter={x:Static util:PanelConverters.EntryModified}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
