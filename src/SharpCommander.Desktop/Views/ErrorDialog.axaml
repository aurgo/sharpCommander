<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SharpCommander.Desktop.Views.ErrorDialog"
        Title="Error"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Border Padding="20">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="M11 15h2v2h-2v-2m0-8h2v6h-2V7m1-5C6.47 2 2 6.5 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2m0 18a8 8 0 0 1-8-8 8 8 0 0 1 8-8 8 8 0 0 1 8 8 8 8 0 0 1-8 8Z"
                          Width="28" Height="28"
                          Foreground="{DynamicResource DangerBrush}"
                          VerticalAlignment="Top" />
                <TextBlock Name="MessageText" Classes="dialog-message" VerticalAlignment="Center" MaxWidth="430" />
            </StackPanel>

            <Expander Name="DetailsExpander" Header="Details" IsVisible="False">
                <StackPanel Spacing="6">
                    <TextBox Name="DetailsBox"
                             Classes="monospace"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="12"
                             MaxHeight="220" />
                    <Button Name="CopyButton" Content="Copy details" HorizontalAlignment="Right" Click="Copy_Click" />
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Name="OkButton" Classes="dialog-button" Content="OK" IsDefault="True" IsCancel="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
