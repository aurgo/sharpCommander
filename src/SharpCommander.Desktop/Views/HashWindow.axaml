<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpCommander.Desktop.ViewModels"
        x:Class="SharpCommander.Desktop.Views.HashWindow"
        x:DataType="vm:HashViewModel"
        Title="File Checksums"
        Width="640"
        SizeToContent="Height"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="TextBlock.hash-label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector="TextBox.hash">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.copy">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Border Padding="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <Button Classes="dialog-button" Content="Copy all" Click="Copy_Click" Tag="{Binding AllHashes}" IsEnabled="{Binding HasResults}" />
                <Button Classes="dialog-button" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsCalculating}" />
                <Button Classes="dialog-button" Content="Close" Click="Close_Click" IsDefault="True" IsCancel="True" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="dialog-title" Text="{Binding FileName}" />
                <TextBlock Classes="dialog-secondary" Text="{Binding FilePath}" />

                <StackPanel IsVisible="{Binding IsCalculating}" Margin="0,10,0,4" Spacing="4">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" />
                    <TextBlock Classes="dialog-secondary" Text="{Binding StatusText}" />
                </StackPanel>

                <TextBlock Classes="dialog-error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Margin="0,8,0,0" />

                <StackPanel IsVisible="{Binding HasResults}" Spacing="6" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="80,*,Auto">
                        <TextBlock Grid.Column="0" Classes="hash-label" Text="MD5" />
                        <TextBox Grid.Column="1" Classes="monospace hash" Text="{Binding Md5}" />
                        <Button Grid.Column="2" Classes="copy" Content="Copy" Click="Copy_Click" Tag="{Binding Md5}" ToolTip.Tip="Copy MD5" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,Auto">
                        <TextBlock Grid.Column="0" Classes="hash-label" Text="SHA-1" />
                        <TextBox Grid.Column="1" Classes="monospace hash" Text="{Binding Sha1}" />
                        <Button Grid.Column="2" Classes="copy" Content="Copy" Click="Copy_Click" Tag="{Binding Sha1}" ToolTip.Tip="Copy SHA-1" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,Auto">
                        <TextBlock Grid.Column="0" Classes="hash-label" Text="SHA-256" />
                        <TextBox Grid.Column="1" Classes="monospace hash" Text="{Binding Sha256}" />
                        <Button Grid.Column="2" Classes="copy" Content="Copy" Click="Copy_Click" Tag="{Binding Sha256}" ToolTip.Tip="Copy SHA-256" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,Auto">
                        <TextBlock Grid.Column="0" Classes="hash-label" Text="SHA-512" />
                        <TextBox Grid.Column="1" Classes="monospace hash" Text="{Binding Sha512}" />
                        <Button Grid.Column="2" Classes="copy" Content="Copy" Click="Copy_Click" Tag="{Binding Sha512}" ToolTip.Tip="Copy SHA-512" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
