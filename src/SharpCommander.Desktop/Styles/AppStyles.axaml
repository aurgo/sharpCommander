<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <!-- Dialog accent colors (destructive actions and validation errors). -->
            <SolidColorBrush x:Key="DangerBrush" Color="#DC3545" />
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#C82333" />
            <SolidColorBrush x:Key="DangerPressedBrush" Color="#A71D2A" />

            <ResourceDictionary.ThemeDictionaries>
                <!--
                    The selected row of the panel that is not active. Each one carries about as much weight as
                    the accent selection of the active panel and no more: a grey brighter than the accent (which
                    is what the stock "base medium low" is on a dark background) pulls the eye to the wrong panel.
                -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="InactivePanelSelectionBrush" Color="#C6C6C6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InactivePanelSelectionBrush" Color="#C6C6C6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="InactivePanelSelectionBrush" Color="#3D3D3D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
    <!-- Panel Styles -->
    <Style Selector="Border.file-panel">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    
    <!-- Header Styles. The active panel (where F5/F6 act) gets an accent underline. -->
    <Style Selector="Border.panel-header">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.panel-header.active">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>

    <!-- Column headers above the file list -->
    <Style Selector="Grid.column-headers">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>

    <Style Selector="Button.column-header">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>

    <Style Selector="Button.column-header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>

    <!-- File list rows are denser than the Fluent default, and the list lights up while files hover over it. -->
    <Style Selector="ListBox.file-list ListBoxItem">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ListBox.file-list">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.file-list.drop-target">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>

    <!--
        Only the active panel highlights its selection in the accent colour; the other one shows a grey one.
        Both lists always have a selected row, so with one colour for both there was no way to tell which list
        F5, F6 and the cursor keys were about to act on. The template part is what is set rather than the item's
        own Background: the theme's own :selected style targets it too, and only the more specific one wins.
    -->
    <Style Selector="ListBox.file-list:not(.active) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InactivePanelSelectionBrush}" />
    </Style>
    
    <Style Selector="TextBlock.panel-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    
    <!-- ListBox Styles -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}" />
    </Style>
    
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    
    <!-- Toolbar Styles -->
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    
    <Style Selector="Button.toolbar-button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinWidth" Value="80" />
    </Style>
    
    <Style Selector="Button.toolbar-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    
    <!-- Function Bar Styles -->
    <Style Selector="Border.function-bar">
        <Setter Property="Padding" Value="4,2" />
    </Style>
    
    <Style Selector="Button.function-button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    
    <Style Selector="Button.function-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    
    <!-- Favorites Panel Styles -->
    <Style Selector="Border.favorites-panel">
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
    </Style>

    <Style Selector="ListBox.favorites-list ListBoxItem">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Tab strip above the panels -->
    <Style Selector="Border.tab-bar">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="Padding" Value="4,0" />
    </Style>

    <!--
        A tab is a plain Border rather than a TabStripItem: the bar holds two independent groups (left-hand and
        right-hand tabs) and only one tab across both is current, which a selection-driven TabStrip cannot express.
    -->
    <Style Selector="Border.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="4,4,0,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.tab TextBlock">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Border.tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>

    <Style Selector="Border.tab.current">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>

    <Style Selector="Border.tab.current TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A pinned tab keeps its folder, so it reads as fixed: italic and no close button. -->
    <Style Selector="Border.tab.pinned TextBlock">
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style Selector="Border.tab.pinned Button.tab-close">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.tab-close">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>

    <Style Selector="Button.tab-add">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Main window status bar: message on the left, operation progress on the right -->
    <Style Selector="Border.main-status-bar">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
    </Style>
    
    <!-- Status Bar Styles -->
    <Style Selector="Border.status-bar">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>
    
    <Style Selector="TextBlock.status-text">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- Path ComboBox Styles -->
    <Style Selector="ComboBox.path-combo">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    
    <!-- Path Bar Styles -->
    <Style Selector="TextBox.path-input">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    
    <!-- Search Input Styles -->
    <Style Selector="TextBox.search-input">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumHighBrush}" />
    </Style>
    
    <!-- Icon Styles -->
    <Style Selector="PathIcon.file-icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    
    <!-- Menu Styles -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    
    <Style Selector="MenuItem">
        <Setter Property="Padding" Value="12,8" />
    </Style>
    
    <!-- Dialog Styles -->
    <Style Selector="Window.dialog">
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="CanResize" Value="False" />
    </Style>

    <Style Selector="TextBlock.dialog-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.dialog-message">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.dialog-secondary">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.dialog-error">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.dialog-button">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Destructive buttons (delete, overwrite) are red in every state. -->
    <Style Selector="Button.destructive">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DangerPressedBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="TextBox.monospace">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    </Style>

    <Style Selector="TextBlock.monospace">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    </Style>

    <Style Selector="SelectableTextBlock.monospace">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    </Style>
    
</Styles>
