<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpCommander.Desktop</RootNamespace>
    <AssemblyName>SharpCommander.Desktop</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Resources/icon.ico</ApplicationIcon>
    <Description>A modern, cross-platform dual-pane file manager built with Avalonia UI</Description>

    <!-- AOT and trimming analysis is always on so problems surface at build time. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!--
      No satellite resource assemblies: the translations live in SharpCommander.Desktop.Localization as plain
      dictionaries, which need no ResourceManager and survive trimming and AOT untouched.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Publishing configuration. All publish scripts rely on these defaults so every platform ships the same way:
    self-contained, single-file, partially trimmed (Avalonia.Controls.DataGrid is not fully trim-safe), no debug
    symbols. Single-file is skipped under AOT, which already emits one native binary.
    Applied only when publishing, so a plain Release build keeps working without a RID.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile Condition="'$(PublishAot)' != 'true'">true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />

    <!-- DPAPI, for the Windows password fallback. Other platforms use their own keychain and never load it. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpCommander.Core\SharpCommander.Core.csproj" />
  </ItemGroup>

  <!--
    Globalization stays on (natural sort order and date formatting need culture data), so the Linux builds
    would otherwise depend on the distribution's libicu and abort at startup on Alpine, slim container images
    and minimal spins with "Couldn't find a valid ICU package installed on the system" - before the log is
    even open. Shipping ICU inside the app removes that dependency; Windows and macOS use the system copy.
  -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <!-- Shipping the libraries is not enough: without this switch the runtime still loads the system libicu. -->
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Styles\*.axaml" />
    <AvaloniaResource Include="Resources/**" Exclude="Resources/*.icns" />
  </ItemGroup>

  <!--
    macOS bundle assets. The condition looks at the TARGET runtime (or at the host only when no RID is set,
    so 'dotnet run' on a Mac still gets its Dock icon via run-macos.sh). Windows and Linux outputs no longer ship them.
  -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">
    <None Include="Info.plist" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources/icon.icns" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Make the test project able to see internal helpers without reflection. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SharpCommander.Tests" />
  </ItemGroup>
</Project>
